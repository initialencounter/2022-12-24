{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@github/mcp-server-mcp"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GH_TOKEN_HERE",
        "HTTP_PROXY": "http://127.0.0.1:7890",
        "HTTPS_PROXY": "http://127.0.0.1:7890"
      }
    }
  }
}
